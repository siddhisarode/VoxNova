# VoxAI Core Environment Variables
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# STT & TTS Providers
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Database & Redis (Optional / Defaults to SQLite if PostgreSQL unavailable)
DATABASE_URL=sqlite+aiosqlite:///./voxai.db
REDIS_URL=redis://localhost:6379/0

# Default Assistant Settings
DEFAULT_SYSTEM_PROMPT="You are a helpful, fast, and friendly voice AI assistant created with VoxAI. Keep your answers brief, conversational, and direct, suitable for voice synthesis."
